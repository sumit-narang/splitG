import cv2

# Load your uploaded image
img = cv2.imread('01052da5-ee9a-4336-bb1f-8a3efee907ba.png')

# Convert to grayscale
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

# Resize to standard size (optional, for uniform template matching)
resized = cv2.resize(gray, (100, 150))  # Adjust size as needed

# Save it
cv2.imwrite('template_g.png', resized)
